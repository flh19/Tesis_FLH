6. Multiple Testing Correction for Rare Variant Analyses

The following Python script was used to extract SKAT-O results and calculate FDR-adjusted p-values.

---

#!/usr/bin/env python3

import sys
import pandas as pd
import numpy as np
from statsmodels.stats.multitest import multipletests
from pathlib import Path

def process_regenie(file_path):
    file_path = Path(file_path)

    # Read REGENIE file while ignoring header comments
    df = pd.read_csv(
        file_path,
        sep=r"\s+",
        comment="#",
        engine="python"
    )

    # Keep only ADD-SKATO rows
    df = df[df["TEST"] == "ADD-SKATO"].copy()

    if df.empty:
        print(f"[WARN] No ADD-SKATO rows found in {file_path.name}")
        return

    # Calculate p-values from LOG10P
    df["Pval"] = 10 ** (-df["LOG10P"])

    # FDR correction
    df["Pval_FDR"] = multipletests(
        df["Pval"],
        method="fdr_bh"
    )[1]

    # Output file
    out_file = file_path.with_suffix(".ADD_SKATO.filtered.tsv")

    # Save filtered results
    df.to_csv(out_file, sep="\t", index=False)

    print(f"[OK] Generated: {out_file.name}")

if __name__ == "__main__":
    if len(sys.argv) < 2:
        sys.exit("Usage: process_regenie_skato.py file1.regenie [file2.regenie ...]")

    for f in sys.argv[1:]:
        process_regenie(f)

