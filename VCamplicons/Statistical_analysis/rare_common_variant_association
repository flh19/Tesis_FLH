4. Multiple Testing Correction for Common Variant Analyses

The following Python script was used to calculate Bonferroni- and FDR-corrected p-values from REGENIE output files.

---

import pandas as pd
import glob
from statsmodels.stats.multitest import multipletests

# Function to calculate Bonferroni and FDR corrections
def correct_pvalues(df):
    p_values = df['Pval'].values

    # Bonferroni correction
    bonferroni_threshold = 0.05 / len(p_values)
    bonferroni_pvalues = multipletests(p_values, method='bonferroni')[1]

    # FDR correction (Benjamini-Hochberg)
    fdr_pvalues = multipletests(p_values, method='fdr_bh')[1]

    # Add corrected values to the DataFrame
    df['Bonferroni_Pval'] = bonferroni_pvalues
    df['FDR_Pval'] = fdr_pvalues

    return df, bonferroni_threshold

# Function to process REGENIE output files
def process_files(file_pattern):
    files = glob.glob(file_pattern)

    for file in files:
        print(f"Processing file: {file}")

        # Read file
        df = pd.read_csv(file, sep="\t")

        # Apply corrections
        df_corrected, bonferroni_threshold = correct_pvalues(df)

        # Print Bonferroni threshold
        print(f"Bonferroni threshold: {bonferroni_threshold}")

        # Save corrected file
        output_file = file.replace(".regenie", "_corrected.regenie")
        df_corrected.to_csv(output_file, sep="\t", index=False)

        print(f"Corrected file saved to: {output_file}\n")

# Process all REGENIE files
process_files('*.regenie')

