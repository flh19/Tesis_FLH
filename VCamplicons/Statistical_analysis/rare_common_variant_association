########## Script para corregir los archivos de regenie (variantes raras) y obtener el valor FDR ##########
#!/usr/bin/env python3

import sys
import pandas as pd
import numpy as np
from statsmodels.stats.multitest import multipletests
from pathlib import Path

def process_regenie(file_path):
    file_path = Path(file_path)

    # Leer archivo ignorando la primera línea (##MASKS)
    df = pd.read_csv(
        file_path,
        sep=r"\s+",
        comment="#",   # ignora líneas que empiezan por ##
        engine="python"
    )

    # Filtrar solo ADD-SKATO
    df = df[df["TEST"] == "ADD-SKATO"].copy()

    if df.empty:
        print(f"[WARN] No hay filas ADD-SKATO en {file_path.name}")
        return

    # Calcular Pval a partir de LOG10P
    df["Pval"] = 10 ** (-df["LOG10P"])

    # Corrección FDR (Benjamini-Hochberg)
    df["Pval_FDR"] = multipletests(
        df["Pval"],
        method="fdr_bh"
    )[1]

    # Nombre del archivo de salida
    out_file = file_path.with_suffix(".ADD_SKATO.filtered.tsv")

    # Guardar
    df.to_csv(out_file, sep="\t", index=False)

    print(f"[OK] Generado: {out_file.name}")

if __name__ == "__main__":
    if len(sys.argv) < 2:
        sys.exit("Uso: procesar_regenie_skato.py archivo1.regenie [archivo2.regenie ...]")

    for f in sys.argv[1:]:
        process_regenie(f)

