############# Script para corregir los archivos de regenie (variantes comunes) y obtener el valor FDR #############
import pandas as pd
import glob
from statsmodels.stats.multitest import multipletests

# Función para corregir p-valores por Bonferroni y FDR
def correct_pvalues(df):
    p_values = df['Pval'].values  # Extrae los p-valores de la columna 'Pval'
    
    # Corregir por Bonferroni
    bonferroni_threshold = 0.05 / len(p_values)  # Umbral Bonferroni
    bonferroni_pvalues = multipletests(p_values, method='bonferroni')[1]
    
    # Corregir por FDR (Benjamini-Hochberg)
    fdr_pvalues = multipletests(p_values, method='fdr_bh')[1]
    
    # Añadir los resultados al DataFrame
    df['Bonferroni_Pval'] = bonferroni_pvalues
    df['FDR_Pval'] = fdr_pvalues
    
    return df, bonferroni_threshold

# Función para procesar archivos y calcular p-valores corregidos
def process_files(file_pattern):
    files = glob.glob(file_pattern)
    
    for file in files:
        print(f"Procesando archivo: {file}")
        
        # Leer el archivo
        df = pd.read_csv(file, sep="\t")
        
        # Corregir p-valores y obtener umbral Bonferroni
        df_corrected, bonferroni_threshold = correct_pvalues(df)
        
        # Mostrar umbral Bonferroni
        print(f"Umbral Bonferroni para este archivo: {bonferroni_threshold}")
        
        # Mostrar algunas filas del DataFrame corregido para validar
        print(df_corrected[['Name', 'Pval', 'Bonferroni_Pval', 'FDR_Pval']].head())

        # Guardar el archivo con los p-valores corregidos
        output_file = file.replace(".regenie", "_corrected.regenie")
        df_corrected.to_csv(output_file, sep="\t", index=False)
        print(f"Archivo corregido guardado en: {output_file}\n")

# Llamar a la función con el patrón de archivo
process_files('*.regenie')

